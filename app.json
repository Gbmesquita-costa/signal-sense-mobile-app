{
  "expo": {
    "name": "SignalSense",
    "slug": "signal-sense",
    "version": "1.0.0",
    "owner": "signalsense",
    "orientation": "portrait",
    "description": "SignalSense is a personal privacy tool that helps you detect signals from devices around you. We don't make absolute promises — we offer awareness.",
    "icon": "./assets/images/icon.png",
    "scheme": "signalsense",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.signalsense.app",
      "icon": "./assets/images/icon.png"
    },
    "platforms": ["android"],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#E0EAFC",
          "dark": {
            "image": "./assets/images/icon.png",
            "imageWidth": 180,
            "backgroundColor": "#0C1A30"
          }
        }
      ],
      "react-native-wifi-reborn",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B0E11"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
